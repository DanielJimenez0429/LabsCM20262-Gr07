# Copia este archivo como keystore.properties (no se sube a git) y completa los datos.
# Genera el keystore con:
#   keytool -genkeypair -v -keystore lab2-release.jks -alias lab2 -keyalg RSA -keysize 2048 -validity 10000
storeFile=lab2-release.jks
storePassword=CAMBIAR
keyAlias=lab2
keyPassword=CAMBIAR
